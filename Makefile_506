CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -pthread

AGENT = agent
CONTROLLER = controller

AGENT_SRC = agent_506.c
CONTROLLER_SRC = controller_506.c

all: $(AGENT) $(CONTROLLER)

$(AGENT): $(AGENT_SRC)
	$(CC) $(CFLAGS) $(AGENT_SRC) -o $(AGENT)

$(CONTROLLER): $(CONTROLLER_SRC)
	$(CC) $(CFLAGS) $(CONTROLLER_SRC) -o $(CONTROLLER)

clean:
	rm -f $(AGENT) $(CONTROLLER)

.PHONY: all clean
